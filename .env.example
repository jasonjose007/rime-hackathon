# Rime TTS Configuration
RIME_API_KEY=your_rime_api_key_here
RIME_VOICE_ID=marsh
RIME_MODEL_ID=mist
RIME_ENDPOINT_URL=https://users.rime.ai/v1/rime-tts
RIME_LANGUAGE=en
RIME_AUDIO_FORMAT=mp3
RIME_SAMPLE_RATE=22050

# Groq API (for ASR - Whisper and LLM fallback)
GROQ_API_KEY=your_groq_api_key_here
ASR_MODEL=whisper-large-v3-turbo

# LLM for intent parsing (optional - rule-based parser works without it)
LLM_API_KEY=your_groq_api_key_here
LLM_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=llama-3.1-8b-instant
